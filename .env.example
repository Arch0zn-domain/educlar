# Local demonstration only. No real personal documents.
APP_MODE=local
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate independent strong secrets before a future live deployment.
# BETTER_AUTH_SECRET=
# DOCUMENT_KEY= (64 hexadecimal characters)
# DATABASE_URL=postgresql://...
# DATA_DIR=.data
# Live SMS and object storage require deployment integration. APP_MODE=live
# deliberately refuses to start until those adapters are supplied.
# Jelly assistant. These are server-only; never use NEXT_PUBLIC_ for secrets.
# Preferred: connect the existing FreeLLMAPI gateway (API port, not dashboard).
# FREELLMAPI_BASE_URL=http://localhost:3001/v1
# FREELLMAPI_API_KEY= (unified key from FreeLLMAPI's Keys page)
# FREELLMAPI_MODEL=auto:fast
# If no gateway URL is set, use Gemini directly in the same Next.js deployment.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# CHAT_CACHE_TTL_SECONDS=86400
# CHAT_MAX_OUTPUT_TOKENS=768
# CHAT_DAILY_LIMIT=20
# CHAT_GLOBAL_DAILY_LIMIT=100
# Hosted demonstration on Vercel: APP_MODE=demo, HTTPS BETTER_AUTH_URL,
# DATABASE_URL (direct PostgreSQL connection), BETTER_AUTH_SECRET and DOCUMENT_KEY.
# A local gateway is unreachable from Vercel. Use a hosted HTTPS gateway URL,
# or omit FREELLMAPI_* and set GEMINI_API_KEY to run everything in one app.
